# --- Server ---
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# --- Postgres ---
DATABASE_URL=postgres://outbox:outbox@127.0.0.1:5434/outbox

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6380

# --- Worker tuning (all configurable, no hardcoding) ---
WORKER_CONCURRENCY=5
# Minimum gap between two email sends (provider throttling), milliseconds
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Per-sender cap per rolling hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Ethereal Email (https://ethereal.email) ---
# Leave both empty to auto-create a throwaway test account at boot.
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack OAuth (https://api.slack.com/apps) ---
# Redirect URL: http://localhost:4000/api/slack/callback
# Bot scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Elasticsearch ---
ELASTIC_NODE=http://127.0.0.1:9201

# --- Sender identities shown in Compose (comma separated) ---
DEFAULT_SENDERS=oliver.brown@domain.io,grant@domain.io
